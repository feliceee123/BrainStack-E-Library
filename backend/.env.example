# ===== Required for local PostgreSQL =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elibrary
# OR individual vars (Wasmer style):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=elibrary
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_SSLMODE=prefer

# ===== Security =====
JWT_SECRET=change-me-to-a-very-long-random-string-in-production

# ===== Optional admin bootstrap =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourStrongPass123
ADMIN_NAME=Administrator

# ===== AI (optional – if missing, rule-based agent is used) =====
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===== Brevo email verification =====
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=BrainStack E-Library
PUBLIC_BASE_URL=http://localhost:8000
